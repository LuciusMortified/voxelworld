#pragma once

#ifndef VW_SCULPTOR_VERSION_H
#define VW_SCULPTOR_VERSION_H

// Configured by CMake and included textually, so it carries no standard
// headers: everything that reaches for it already has `import std`.
namespace vw::sculptor {
    constexpr int version_major = @PROJECT_VERSION_MAJOR@;
    constexpr int version_minor = @PROJECT_VERSION_MINOR@;
    constexpr int version_patch = @PROJECT_VERSION_PATCH@;

    inline constexpr auto version_string = "@PROJECT_VERSION@";
} // namespace vw::sculptor

#endif // VW_SCULPTOR_VERSION_H
