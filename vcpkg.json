{
  "name": "voxel-world",
  "version-string": "0.0.1",
  "dependencies": [
    "catch2"
  ],
  "default-features": [
    "gfx"
  ],
  "features": {
    "gfx": {
      "description": "Window, renderer and debug UI dependencies",
      "dependencies": [
        "glfw3",
        {
          "name": "imgui",
          "features": [
            "glfw-binding",
            "vulkan-binding"
          ]
        }
      ]
    }
  }
}
