# C++: Лучшие практики разработки

## Обработка ошибок

### Исключения
**Использовать исключения для ошибок времени выполнения:**

```cpp
// ✅ Правильно
class file_error : public std::runtime_error {
public:
    explicit file_error(const std::string& message) 
        : std::runtime_error("File error: " + message) {}
};

void load_texture(const std::string& path) {
    std::ifstream file(path);
    if (!file.is_open()) {
        throw file_error("Cannot open file: " + path);
    }
}
```

### Коды возврата
**Использовать для ожидаемых ошибок:**

```cpp
// ✅ Правильно
enum class load_result {
    success,
    file_not_found,
    invalid_format,
    out_of_memory
};

load_result load_model(const std::string& path, model& result) {
    if (!std::filesystem::exists(path)) {
        return load_result::file_not_found;
    }
    return load_result::success;
}
```

## Управление ресурсами

### RAII принцип
**Всегда использовать RAII для управления ресурсами:**

```cpp
#include "types.h"

// ✅ Правильно - RAII класс
class texture {
private:
    uint32 handle_;
    
public:
    texture() : handle_(0) {
        glGenTextures(1, &handle_);
        if (handle_ == 0) {
            throw std::runtime_error("Failed to create texture");
        }
    }
    
    ~texture() {
        if (handle_ != 0) {
            glDeleteTextures(1, &handle_);
        }
    }
    
    // Запрет копирования
    texture(const texture&) = delete;
    texture& operator=(const texture&) = delete;
    
    // Разрешение перемещения
    texture(texture&& other) noexcept : handle_(other.handle_) {
        other.handle_ = 0;
    }
    
    texture& operator=(texture&& other) noexcept {
        if (this != &other) {
            if (handle_ != 0) {
                glDeleteTextures(1, &handle_);
            }
            handle_ = other.handle_;
            other.handle_ = 0;
        }
        return *this;
    }
    
    uint32 get_handle() const { return handle_; }
};
```

### Умные указатели
**Предпочитать std::unique_ptr и std::shared_ptr:**

```cpp
// ✅ Правильно
class mesh_manager {
private:
    std::unordered_map<std::string, std::unique_ptr<mesh>> meshes_;
    
public:
    void add_mesh(const std::string& name, std::unique_ptr<mesh> mesh) {
        meshes_[name] = std::move(mesh);
    }
    
    mesh* get_mesh(const std::string& name) {
        auto it = meshes_.find(name);
        return it != meshes_.end() ? it->second.get() : nullptr;
    }
};
```

## Производительность

### Передача параметров
**Использовать const ссылки для больших объектов, move семантику для перемещения:**

```cpp
// ✅ Правильно - const ссылка для чтения
void process_vertices(
    const std::vector<vertex>& vertices,
    const transform& transform
) {
}

// ✅ Правильно - move семантика для перемещения
void add_vertices(std::vector<vertex> vertices) {
    vertices_.insert(vertices_.end(), 
                    std::make_move_iterator(vertices.begin()),
                    std::make_move_iterator(vertices.end()));
}

// ❌ Неправильно - ненужное копирование
void bad_process_vertices(
    std::vector<vertex> vertices,  // копирование без необходимости
    transform transform             // копирование без необходимости
) {
}
```

### Move семантика
**Использовать std::move для rvalue и перемещения объектов:**

```cpp
// ✅ Правильно - возврат по значению с автоматическим move
std::vector<vertex> create_vertices() {
    std::vector<vertex> result;
    result.reserve(1000);
    for (int i = 0; i < 1000; ++i) {
        result.emplace_back(i, i, i);
    }
    return result;  // автоматический move (RVO/NRVO)
}

// ✅ Правильно - перемещение в параметрах
class mesh_builder {
private:
    std::vector<vertex> vertices_;
    
public:
    void add_vertices(std::vector<vertex> vertices) {
        vertices_.insert(vertices_.end(), 
                        std::make_move_iterator(vertices.begin()),
                        std::make_move_iterator(vertices.end()));
    }
    
    void add_vertex(vertex v) {
        vertices_.push_back(std::move(v));
    }
};

// ✅ Правильно - перемещение в конструкторах
class mesh {
private:
    std::vector<vertex> vertices_;
    std::string name_;
    
public:
    mesh(std::vector<vertex> vertices, std::string name)
        : vertices_(std::move(vertices)), name_(std::move(name)) {}
};

// ✅ Правильно - перемещение в присваивании
void update_mesh() {
    std::vector<vertex> new_vertices = create_vertices();
    mesh_builder builder;
    builder.add_vertices(std::move(new_vertices));  // явный move
}

// ❌ Неправильно - ненужный move
void bad_example() {
    std::vector<vertex> vertices = create_vertices();
    builder.add_vertices(std::move(vertices));  // vertices теперь пустой!
    // vertices.size() == 0 - объект перемещен
}
```

## Безопасность

### Валидация входных данных
**Проверять все входные параметры:**

```cpp
// ✅ Правильно
void set_resolution(int width, int height) {
    if (width <= 0 || height <= 0) {
        throw std::invalid_argument("Resolution must be positive");
    }
    if (width > MAX_RESOLUTION || height > MAX_RESOLUTION) {
        throw std::invalid_argument("Resolution too large");
    }
    
    width_ = width;
    height_ = height;
}
```

